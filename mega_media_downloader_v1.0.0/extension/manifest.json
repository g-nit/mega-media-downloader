{
  "manifest_version": 3,
  "name": "MEGA Media Downloader",
  "version": "1.4.0",
  "description": "Queue public MEGA links to Movies, TV, or custom folders using megatools.",
  "permissions": [
    "storage",
    "sidePanel",
    "nativeMessaging"
  ],
  "icons": {
  "16": "icons/icon16.png",
  "32": "icons/icon32.png",
  "48": "icons/icon48.png",
  "128": "icons/icon128.png"
},
"action": {
  "default_title": "MEGA Media Downloader",
  "default_icon": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png"
  }
},
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}